# Configuration of local-integration.sh. Copy this file to `.env.local` (git-ignored).
# As committed, it runs the toolkit over this repository's fixture pair, `tests/fixtures/collector-gh/`. For another
# component's output, point DOC_INPUT and TESTS_INPUT at the two files its run wrote.
#
# One `KEY=value` per line; a line starting with `#` is a comment. Values are taken literally - no variable
# expansion, and no comment after a value. A relative path resolves against this repository's root, and `~/` is the
# home directory. The script reads no other key: no token, since every command reads local files and calls no API.

# The documentation input, a `doc-source` artifact; `normalize-docs` and `coverage-matrix` read it.
DOC_INPUT=tests/fixtures/collector-gh/doc-source.json
# The tests input, a `ui-tests` artifact; `normalize-tests` and `coverage-matrix` read it.
TESTS_INPUT=tests/fixtures/collector-gh/ui-tests.json

# Optional: the view `normalize-docs` and `coverage-matrix` write, `inner` or `release`. Empty means `inner`.
VIEW=inner

# Optional: the output root. Each command writes `$OUT_DIR/toolkit/<command>/<output>.json`; `./output` is
# git-ignored.
OUT_DIR=./output

# Optional: the Python >= 3.10 the venv is built from. Empty means `python3`, else `python`, from PATH. On Git Bash
# for Windows, `python3` may be the Microsoft Store alias, which does not run: set `PYTHON=python` there.
PYTHON=
